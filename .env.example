# ===== 本地 MySQL 行情数据源（wucai_trade，强烈推荐设置）=====
# 设置后行情全部走本地库（500万+日线/130板块/5万+新闻），无需外网
# 密码只读环境变量，绝不写进代码或仓库
WUCAI_SQL_PASSWORD=
WUCAI_SQL_HOST=127.0.0.1
WUCAI_SQL_PORT=3306
WUCAI_SQL_USER=root
WUCAI_SQL_DATABASE=wucai_trade

# ===== 实时新闻（无需配置，自动抓取）=====
# 东财724快讯 + 财联社电报，每15分钟刷新，无需 key
# 抓取结果缓存到 live_news.db

# ===== ARTi 智能分析增强（可选）=====
# ARTi 开发者 API Key（https://www.artifin.ai 开发者页面创建）
# 不填：本地数据引擎独立生成全部分析（真实指标+实时新闻，功能完整）
# 填了：在本地数据引擎结果上叠加 arti-news/chat/council 智能解读
ARTI_API_KEY=

# 强制关闭 ARTi 增强（1=只用本地数据引擎，省 credits；0=有 key 时用 ARTi）
ARTI_MOCK=0

# 首屏扫描的板块数量（默认6）
TOP_SECTORS=6

# 每个板块精选的股票数量（默认4）
STOCKS_PER_SECTOR=4
